set -e

MTRACK_USER=mtrack
MTRACK_BIN=/usr/bin/mtrack
DEFAULTS=/etc/default/mtrack
UNIT=/etc/systemd/system/mtrack.service
STATE_DIR=/var/lib/mtrack-packaging
UNIT_STAMP="$STATE_DIR/mtrack.service.md5"

# The unit is generated by the installed binary rather than shipped as a file,
# so `mtrack systemd` stays the single definition of what the service looks
# like. It also means an upgrade re-renders the unit against the new binary,
# which is the step the deployment guide otherwise asks operators to remember.
generate_unit() {
    target="$1"
    path="$2"

    # Always the absolute path, never PATH. `mtrack systemd` renders ExecStart=
    # from its own argv[0], and the installation guide has been telling people
    # to copy the binary to /usr/local/bin for years -- which comes first on a
    # default PATH. Resolving through PATH would hand anyone upgrading from a
    # tarball install a unit pointing at their old binary.
    #
    # A path mtrack rejects (relative, quoted, `/`) would otherwise abort the
    # whole postinst. Fall back to the pathless unit, which still runs -- it
    # just gets ProtectSystem=full instead of strict.
    if [ -n "$path" ] && "$MTRACK_BIN" systemd "$path" > "$target" 2>/dev/null; then
        return 0
    fi
    "$MTRACK_BIN" systemd > "$target"
}

case "$1" in
    configure)
        # --- Service account -------------------------------------------------
        if ! getent passwd "$MTRACK_USER" >/dev/null 2>&1; then
            adduser --system --group --no-create-home \
                    --home /var/lib/mtrack \
                    --shell /usr/sbin/nologin \
                    --gecos "mtrack multitrack player" \
                    "$MTRACK_USER" >/dev/null
        fi
        # ALSA sound cards and MIDI devices. Matches SupplementaryGroups= in the
        # generated unit; adding groups the unit does not carry would do nothing.
        if getent group audio >/dev/null 2>&1; then
            adduser "$MTRACK_USER" audio >/dev/null 2>&1 || true
        fi

        # --- Project directory -----------------------------------------------
        MTRACK_PATH=/var/lib/mtrack
        # shellcheck source=/dev/null
        [ -r "$DEFAULTS" ] && . "$DEFAULTS"

        if [ -n "$MTRACK_PATH" ] && [ ! -e "$MTRACK_PATH" ]; then
            mkdir -p "$MTRACK_PATH"
        fi
        # Only take ownership of the directory this package created. A library
        # the operator pointed us at may deliberately belong to someone else,
        # and recursively chowning a mounted song collection is not ours to do.
        if [ "$MTRACK_PATH" = "/var/lib/mtrack" ] && [ -d "$MTRACK_PATH" ]; then
            chown "$MTRACK_USER:$MTRACK_USER" "$MTRACK_PATH"
        fi

        mkdir -p "$STATE_DIR"

        # --- systemd unit ----------------------------------------------------
        NEW_UNIT="$(mktemp)"
        trap 'rm -f "$NEW_UNIT"' EXIT INT TERM
        generate_unit "$NEW_UNIT" "$MTRACK_PATH"

        if [ ! -f "$UNIT" ]; then
            install -m 644 "$NEW_UNIT" "$UNIT"
            md5sum < "$NEW_UNIT" > "$UNIT_STAMP"
        elif [ -f "$UNIT_STAMP" ] && md5sum < "$UNIT" | cmp -s - "$UNIT_STAMP"; then
            # Untouched since we last wrote it, so it is ours to replace.
            install -m 644 "$NEW_UNIT" "$UNIT"
            md5sum < "$NEW_UNIT" > "$UNIT_STAMP"
        elif ! cmp -s "$NEW_UNIT" "$UNIT"; then
            echo "mtrack: $UNIT has local changes; leaving it as it is." >&2
            echo "mtrack: to take the packaged unit instead, run:" >&2
            echo "mtrack:   sudo mtrack systemd $MTRACK_PATH > $UNIT" >&2
            echo "mtrack:   sudo systemctl daemon-reload" >&2
        fi
        rm -f "$NEW_UNIT"
        trap - EXIT INT TERM

        # --- Leftovers from a tarball install --------------------------------
        # The unit runs $MTRACK_BIN either way, so the service is unaffected --
        # but /usr/local/bin comes first on a default PATH, so `mtrack` typed at
        # a shell would still be the old copy, and `mtrack --version` would
        # disagree with the package for reasons that are not obvious.
        if [ -x /usr/local/bin/mtrack ]; then
            echo "mtrack: /usr/local/bin/mtrack exists and shadows the packaged" >&2
            echo "mtrack: binary on PATH. The service uses $MTRACK_BIN; remove the" >&2
            echo "mtrack: old copy so the command line agrees with it." >&2
        fi

        # --- Service ---------------------------------------------------------
        # /run/systemd/system exists only under a booted systemd; skipping it
        # keeps installs working in chroots, containers and image builds.
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
            if [ -z "$2" ]; then
                # First install.
                systemctl enable mtrack.service >/dev/null 2>&1 || true
                systemctl start mtrack.service >/dev/null 2>&1 || true
            else
                # Upgrade: only bounce a service that was already running.
                systemctl try-restart mtrack.service >/dev/null 2>&1 || true
            fi
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
