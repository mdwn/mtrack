set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop mtrack.service >/dev/null 2>&1 || true
            systemctl disable mtrack.service >/dev/null 2>&1 || true
        fi
        ;;

    upgrade|failed-upgrade)
        # Left running deliberately. postinst try-restarts it against the new
        # binary, so an upgrade costs a restart rather than a stop and a start.
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
