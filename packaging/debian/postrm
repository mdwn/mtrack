set -e

UNIT=/etc/systemd/system/mtrack.service
STATE_DIR=/var/lib/mtrack-packaging

case "$1" in
    remove)
        # Generated by postinst, so dpkg does not know to remove it -- and it
        # points at a binary that is now gone.
        rm -f "$UNIT"
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
        fi
        ;;

    purge)
        rm -f "$UNIT"
        rm -rf "$STATE_DIR"
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
        fi

        # /var/lib/mtrack is the song library, playlists, lighting and config.
        # Purging a package should not take a band's set with it, so it stays,
        # and so does the account that owns it -- deleting the user would strand
        # those files under an unallocated uid that a reinstall would not match.
        if [ -d /var/lib/mtrack ]; then
            echo "mtrack: /var/lib/mtrack was left in place -- it holds songs,"
            echo "mtrack: playlists, lighting and config. Remove it by hand if"
            echo "mtrack: you are sure, along with the 'mtrack' system user."
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
